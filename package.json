{
  "name": "islet",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "desktop": "tauri dev",
    "desktop:build": "node scripts/setup-runtime.mjs && tauri build && node scripts/sign-preview.mjs",
    "test:backend": "node --test tests/backend/engine.test.mjs tests/backend/codespaces.test.mjs tests/backend/host-lifetime.test.mjs",
    "test:ui": "node tests/ui-regression.mjs && node tests/interpreter-ui.mjs && node tests/codespaces-ui.mjs && node tests/sidebar-terminal-ui.mjs && node tests/tabs-navigation-ui.mjs && node tests/updates-ui.mjs && node tests/formats-callers-ui.mjs",
    "dev:app": "node scripts/dev.mjs",
    "runtime:setup": "node scripts/setup-runtime.mjs",
    "runtime:remote": "node scripts/setup-runtime.mjs --remote",
    "test:ssh": "node scripts/remote-test.mjs",
    "format": "prettier --write src remote-helper scripts tests vite.config.ts",
    "test:package": "node tests/backend/package-smoke.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/commands": "^6.10.0",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.11.3",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.2",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.8",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@lezer/highlight": "^1.2.1",
    "@tauri-apps/api": "^2.9.0",
    "basedpyright": "^1.32.1",
    "codemirror": "^6.0.2",
    "dompurify": "^3.3.0",
    "highlight.js": "^11.12.0",
    "lucide-react": "^0.468.0",
    "markdown-it": "^14.1.0",
    "markdown-it-task-lists": "^2.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "typescript-language-server": "^5.1.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tauri-apps/cli": "^2.9.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "vite": "^7.1.0"
  }
}
