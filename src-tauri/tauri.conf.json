{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Islet",
  "version": "0.1.2",
  "identifier": "dev.islet.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Islet",
        "width": 1280,
        "height": 820,
        "minWidth": 700,
        "minHeight": 450,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http:; font-src 'self' data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "resources": [
      "resources/runtime/**/*",
      "resources/remote/**/*",
      "../remote-helper/*.mjs",
      "../scripts/islet.mjs"
    ],
    "macOS": {
      "minimumSystemVersion": "13.5"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQzMDJEQTNCNTAwNURFM0QKUldROTNnVlFPOW9DUXd4cXBjbGtleWJWZExIcmtiNHZhSEVqSTNGcDFVb0c4SEk1UThUWG9RWlUK",
      "endpoints": [
        "https://github.com/saadqc/Islet/releases/download/updater/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
