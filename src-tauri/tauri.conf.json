{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Islet",
  "version": "0.1.11",
  "identifier": "dev.islet.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Islet",
        "width": 1280,
        "height": 820,
        "minWidth": 700,
        "minHeight": 450,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http:; font-src 'self' data:; connect-src 'self' data: blob: ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "resources": [
      "resources/runtime/**/*",
      "resources/remote/**/*",
      "../remote-helper/*.mjs",
      "../scripts/islet.mjs"
    ],
    "macOS": {
      "minimumSystemVersion": "13.5"
    },
    "fileAssociations": [
      {
        "ext": [
          "csv"
        ],
        "name": "CSV spreadsheet",
        "mimeType": "text/csv",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": [
          "xls",
          "xlsx"
        ],
        "name": "Excel workbook",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": [
          "docx"
        ],
        "name": "Word document",
        "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": [
          "txt",
          "md",
          "markdown",
          "py",
          "js",
          "jsx",
          "ts",
          "tsx",
          "json",
          "yaml",
          "yml",
          "toml",
          "xml",
          "sql",
          "ini",
          "sh"
        ],
        "name": "Text and source code",
        "role": "Editor",
        "rank": "Alternate"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQzMDJEQTNCNTAwNURFM0QKUldROTNnVlFPOW9DUXd4cXBjbGtleWJWZExIcmtiNHZhSEVqSTNGcDFVb0c4SEk1UThUWG9RWlUK",
      "endpoints": [
        "https://github.com/saadqc/Islet/releases/download/updater/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
